@startuml 4-3-rezervacije-CD
title Oblikovanje rezervacija - dijagram razreda
skinparam shadowing false
hide empty members

class RezervacijaController {
  +dohvatiSveKorisnikoveRezervacije() : List<RezervacijaResponse>
  +dohvatiRezervaciju(id : Long) : RezervacijaResponse
  +rezerviraj(request : RezervacijaRequest) : RezervacijaResponse
  +azurirajRezervaciju(id : Long, request : RezervacijaRequest) : RezervacijaResponse
  +otkaziRezervaciju(id : Long) : void
}
interface RezervacijaService {
  +rezerviraj(request : RezervacijaRequest, korisnikId : Long) : Rezervacija
  +azurirajRezervaciju(id : Long, request : RezervacijaRequest, korisnikId : Long) : Rezervacija
  +otkazi(id : Long, korisnikId : Long) : void
  +potvrdiZahtjeve(terminId : Long, brojMjesta : Integer) : void
  +dohvatiSveKorisnikoveRezervacije(korisnikId : Long) : List<Rezervacija>
}
class RezervacijaServiceImpl
interface TerminService {
  +getTermin(id : Long) : Termin
  +dohvatiBrojSlobodnihMjesta(termin : Termin) : Integer
}
interface MailService {
  +posaljiPotvrduRezervacije(r : Rezervacija) : void
  +posaljiPotvrdeRezervacija(r : Collection<Rezervacija>) : void
  +posaljiOtkazivanjeRezervacije(r : Rezervacija) : void
}
interface RezervacijaRepository <<JpaRepository>> {
  +findByKorisnik(k : Korisnik) : List<Rezervacija>
  +potvrdi(r : Rezervacija) : void
  +dohvatiZahtjeveZaTermin(terminId : Long) : List<Rezervacija>
}
interface TerminRepository <<JpaRepository>> {
  +findByIdForUpdate(id : Long) : Optional<Termin>
  +getNumberOfAvailableSpots(t : Termin) : Integer
}
class Rezervacija <<Entity>> {
  -id : Long
  -status : Status
  -brojMjesta : Integer
  -vrijemeRezervacije : LocalDateTime
}
class Termin <<Entity>> {
  -datumVrijeme : LocalDateTime
  -trajanjeMinuta : Integer
  -kapacitet : Integer
  -cijena : Double
}
class Korisnik <<Entity>>
class DodatnaUsluga <<Entity>>
enum Status {
  ZAHTJEV
  POTVRDENO
  REALIZIRANO
  OTKAZANO
}

RezervacijaController --> RezervacijaService
RezervacijaServiceImpl ..|> RezervacijaService
RezervacijaServiceImpl --> TerminService
RezervacijaServiceImpl --> TerminRepository
RezervacijaServiceImpl --> MailService
RezervacijaServiceImpl --> RezervacijaRepository
RezervacijaRepository ..> Rezervacija
TerminRepository ..> Termin
Rezervacija --> "1" Termin
Rezervacija --> "0..1" Korisnik
Rezervacija --> "0..*" DodatnaUsluga
Rezervacija --> Status
@enduml
