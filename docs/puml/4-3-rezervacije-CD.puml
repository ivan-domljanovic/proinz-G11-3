@startuml 4-3-rezervacije-CD
title Oblikovanje rezervacija - dijagram razreda
skinparam shadowing false
hide empty members

class RezervacijaController {
  +dohvatiSve() : List<RezervacijaResponse>
  +rezerviraj(request : RezervacijaRequest) : RezervacijaResponse
  +azuriraj(id : Long, request : RezervacijaRequest) : RezervacijaResponse
  +otkazi(id : Long) : void
}
interface RezervacijaService {
  +rezerviraj(request, korisnikId) : Rezervacija
  +azurirajRezervaciju(id, request, korisnikId) : Rezervacija
  +otkazi(id, korisnikId) : void
  +potvrdiZahtjeve(brojMjesta : Integer) : void
}
class RezervacijaServiceImpl
interface TerminService {
  +dohvatiTermin(id) : Termin
  +dohvatiBrojSlobodnihMjesta(termin) : Integer
}
interface MailService {
  +posaljiPotvrduRezervacije(r : Rezervacija) : void
  +posaljiOtkazivanjeRezervacije(r : Rezervacija) : void
}
interface RezervacijaRepository <<JpaRepository>> {
  +findByKorisnik(k : Korisnik) : List<Rezervacija>
  +otkazi(r : Rezervacija) : void
  +potvrdi(r : Rezervacija) : void
  +dohvatiZahtjeveSortiranoPoVremenuRezervacije() : List<Rezervacija>
}
class Rezervacija <<Entity>> {
  -id : Long
  -status : Status
  -brojMjesta : Integer
  -vrijemeRezervacije : LocalDateTime
}
class Termin <<Entity>> {
  -datumVrijeme : LocalDateTime
  -kapacitet : Integer
  -cijena : Double
}
class Korisnik <<Entity>>
class DodatnaUsluga <<Entity>>
enum Status {
  ZAHTJEV
  POTVRDENO
  REALIZIRANO
  OTKAZANO
}

RezervacijaController --> RezervacijaService
RezervacijaServiceImpl ..|> RezervacijaService
RezervacijaServiceImpl --> TerminService
RezervacijaServiceImpl --> MailService
RezervacijaServiceImpl --> RezervacijaRepository
RezervacijaRepository ..> Rezervacija
Rezervacija --> "1" Termin
Rezervacija --> "0..1" Korisnik
Rezervacija --> "0..*" DodatnaUsluga
Rezervacija --> Status
@enduml
