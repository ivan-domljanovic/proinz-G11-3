###
GET http://localhost:8080/api/izleti

###

GET http://localhost:8080/api/izleti/1

###

POST http://localhost:8080/api/izleti
Content-Type: application/json

{
  "naziv": "Neki novi izlet",
  "opis": "Ovo je najnoviji izlet...",
  "trajanjeMinuta": 1440,
  "cijena": 649.9,
  "kapacitet": 26,
  "potrebanBrojVodica": 2,
  "kategorijaAktivnosti": "something",
  "lokacija": "Zagreb",
  "mjestoPolaska": "Sesvete",
  "atrakcije": [
    1,
    2
  ],
  "dodatneUsluge": [
    1,
    2
  ]
}

> {%
    client.test("Uspjesno kreira novi izlet #1", () => {
        client.assert(response.status == 201, "Nije uspjesno kreiran")
    })
%}

